id": 0, "template_override": 1}, {"id": 1, "contents": [{"value": {"audiosrc": "engenn2le08ob09re2aud01", "images": [{"image": "engenn2le08ob09re2img05.jpg", "id": 0, "text": "", "time": "0"}, {"image": "engenn2le08ob09re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Sally</span>: Hey Peter! What are you doing? Did you get a call?<br>\n<span class=\"strong\">Peter</span>:      I'm checking my e-mail. Unfortunately, no news about the interview!<br>\n<span class=\"strong\">Sally</span>: I know how you must be feeling, but you know what they say, no news is good news!<br>", "time": "10"}, {"image": "engenn2le08ob09re2img02.jpg", "id": 2, "text": "<span class=\"strong\">Peter</span>:      I really want this job!<br />\n<span class=\"strong\">Sally</span>: Don't worry!<br />\n<span class=\"strong\">Peter</span>:      I don't think they like me. I'm stressing out! Nothing is coming up!<br />\n<span class=\"strong\">Sally</span>: It's sunny outside! Why don't we go out and do something? It can help take your mind off things.", "time": "14300"}, {"image": "engenn2le08ob09re2img03.jpg", "id": 3, "text": "<span class=\"strong\">Peter</span>:      Great idea, but I regret to tell you that it's supposed to rain.<br />\n<span class=\"strong\">Sally</span>: Oh dear! That's unfortunate! You are funny, Peter! We could go to the park or we could go to the museum!<br />\n<span class=\"strong\">Peter</span>: Let's go to the museum.", "time": "32300"}], "coverimg": "engenn2le08ob09re2img05.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "title": ""}], "id": 0, "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}]}