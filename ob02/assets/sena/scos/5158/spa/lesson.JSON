}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self-Assessment. "}]}], "template_override": 1}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Peter's Job Interview"}, {"type": "unit_name", "content": "Looking Forward to Hearing from You"}, {"type": "position", "content": 2}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 8}, {"type": "level", "content": "A1.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": " Exchange information on instructions about basic activities and safety at work.  "}, {"type": "secondary_1", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_2", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.  "}, {"type": "secondary_3", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_4", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.  "}, {"type": "secondary_5", "content": "Understands key information in written texts about the communicative topics related to this level"}, {"type": "secondary_6", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_7", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_8", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.  "}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Talking about Time"}, {"type": "describer", "content": " This is how you talk about time:"}, {"type": "table", "content": "{\"rows\":\"05\",\"columns\":\"02\",\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Time Period</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Examples</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Midnight - Noon\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">a.m.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Noon - Midnight\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> p.m. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"A specific time\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> at 10:00 a.m. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"A period of time\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> 15 minutes </span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "text", "content": "You can use the Simple Present tense to talk about time."}, {"type": "example", "content": "The meeting starts in 15 minutes."}, {"type": "example", "content": "It is 12:00 now."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Replying to a Formal E-mail"}, {"type": "describer", "content": "Here is the structure of a formal e-mail of response or reply:"}, {"type": "text", "content": "You start with an introduction that says what you are responding to. <br />Then, you confirm the information or provide the correct information. <br />Last, you ask if this is okay and offer the receiver (the person you are replying to) the opportunity to contact you. "}, {"type": "text", "content": "Example: <br /><span class=\"italic\">Dear Mr. Smith, <br /><br />  This e-mail is in response to your inquiry.<br /><br />  This is confirmation of your appointment at 10: 30 a.m. <br /><br />  You can e-mail me with any questions or concerns. Please arrive 15 minutes early. <br /><br />  Regards,<br /> Jenny Dunn</span>"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "interested "}, {"type": "definition", "content": "giving a lot of attention to something"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: I'm very interested in this position. "}, {"type": "audio", "content": "engenn2le08ob02aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you use when writing an e-mail about work."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to postpone "}, {"type": "definition", "content": "to change the time or date to a later one "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: He is postponing your interview to this afternoon. "}, {"type": "audio", "content": "engenn2le08ob02aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to confirm "}, {"type": "definition", "content": "to tell someone that an event is happening "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Please confirm you can attend. "}, {"type": "audio", "content": "engenn2le08ob02aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to look forward to "}, {"type": "definition", "content": "to think positively about something happening in the future  "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I'm looking forward to meeting you."}, {"type": "audio", "content": "engenn2le08ob02aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to attend "}, {"type": "definition", "content": "to go to an event "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Please confirm that you can attend the interview."}, {"type": "audio", "content": "engenn2le08ob02aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "opportunity "}, {"type": "definition", "content": "a chance to do something  "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Thank you for this opportunity."}, {"type": "audio", "content": "engenn2le08ob02aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "in response to "}, {"type": "definition", "content": "something that you say or write as a reaction to something else "}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: This e-mail is in response to your interview."}, {"type": "audio", "content": "engenn2le08ob02aud07"}]}, {"type": "background_image", "content": "engenn2le08ob02re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "You get an e-mail inviting you to come in for an interview at 4:00 p.m. tomorrow."}, {"type": "text", "content": "Write a reply back."}, {"type": "text", "content": "Ask to come at a different time."}, {"type": "text", "content": "Read your e-mail aloud. "}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write a reply to an e-mail."}, {"type": "text", "content": "I write about times of the day."}, {"type": "text", "content": "I write about work."}]}], "type": "sena"}